.PHONY: all test serve clean
# Burn2Slot for GB-Link
#   make          build the GBA flasher and embed it in the web page (web/burn2slot_mb.js)
#   make test     build the simulator and run the protocol/flash tests (needs node)
#   make serve    serve the web page on http://localhost:8080 (WebUSB needs localhost or https)
GBAFIX ?= $(shell command -v gbafix || echo python3 $(CURDIR)/tools/gbafix.py)

all: web/burn2slot_mb.js

gba/burn2slot_mb.gba: $(wildcard gba/*.c gba/*.h gba/*.s gba/*.ld)
	$(MAKE) -C gba GBAFIX=$(GBAFIX) all

web/burn2slot_mb.js: gba/burn2slot_mb.gba
	python3 -c "import base64; d=open('$<','rb').read(); open('$@','w').write('// Burn2Slot GBA flasher (multiboot image built from ../gba). Generated by the Makefile - do not edit.\nwindow.BURN2SLOT_MB = \'' + base64.b64encode(d).decode() + '\';\n')"

sim/sim: $(wildcard sim/*.c gba/*.c gba/*.h)
	$(MAKE) -C sim

test: sim/sim
	QUIET=1 node test/run.js amd 0 0 1 200000 0 1
	QUIET=1 node test/run.js amd 2 3 1 150003 20 2
	QUIET=1 node test/run.js amd 5 5 1 150003 20 3
	QUIET=1 node test/run.js intel 0 0 2 300001 20 4
	SIM_SAVE=flash128 node test/run_save.js 4 4 20
	SIM_SAVE=eeprom64k SIM_ROMSTR=EEPROM_V124 node test/run_save.js 6 6
	SIM_SAVE=sram32 node test/run_save.js 1 1

serve:
	cd web && python3 -m http.server 8080

clean:
	$(MAKE) -C gba clean
	rm -f sim/sim sim/*.o
